APP_ENV=development
# Exact browser origin, no trailing slash. Set to your final Vercel URL in production.
APP_URL=http://127.0.0.1:5173
PRESIDENT_NAME="University President"
# The only credential requested by the portal. Use a strong, private passcode.
# Never commit the real .env file.
PRESIDENT_PASSCODE=
# Optional: use a PHP password_hash() value instead of a plaintext passcode.
# Single-quote hashes so dollar signs remain literal.
PRESIDENT_PASSCODE_HASH=
SESSION_TTL=3600
# Optional shared secret: set the same value as PULSE_PROXY_SECRET in Vercel.
PULSE_PROXY_SECRET=

# Integration preparation only. No connections are enabled by default.
# A website URL is not assumed to be its API base URL. Confirm the API contract first.
SINQ_ENABLED=false
SINQ_API_BASE_URL=
SINQ_SUMMARY_PATH=
SINQ_API_ALLOWED_HOST=sinq.sksu-orms.net
SINQ_AUTH_TYPE=bearer
SINQ_API_TOKEN=
SINQ_API_KEY_HEADER=X-API-Key
SINQ_FACULTY_ENABLED=false
SINQ_FACULTY_PATH=/backend/pulse_api.php?resource=faculty-profiles

ORACLE_ENABLED=false
ORACLE_API_BASE_URL=
ORACLE_SUMMARY_PATH=
ORACLE_API_ALLOWED_HOST=sksu-oracle.com
ORACLE_AUTH_TYPE=bearer
ORACLE_API_TOKEN=
ORACLE_API_KEY_HEADER=X-API-Key

PAD_ENABLED=false
PAD_API_BASE_URL=
PAD_SUMMARY_PATH=
PAD_API_ALLOWED_HOST=pad-web-coral.vercel.app
PAD_AUTH_TYPE=bearer
PAD_API_TOKEN=
PAD_API_KEY_HEADER=X-API-Key

# Explicit ownership prevents duplicate totals when systems overlap.
# Values are sinq, oracle, or pad, assigned after each system's fields are confirmed.
PULSE_INSTRUCTION_SOURCE=
PULSE_RESEARCH_SOURCE=
PULSE_EXTENSION_SOURCE=
PULSE_PRODUCTION_SOURCE=
PULSE_INVENTORY_SOURCE=
PULSE_FINANCE_SOURCE=
DASHBOARD_PERIOD_KEY=
DASHBOARD_PERIOD_LABEL=
DASHBOARD_DATA_MAX_AGE_SECONDS=86400
INTEGRATION_TIMEOUT_SECONDS=15
