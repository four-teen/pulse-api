# Local-only development override. Copy to .env.local; never use in production.
# The loader reads .env.local only when APP_ENV=development.
SINQ_FACULTY_LOCAL_TEST_ENABLED=true
SINQ_FACULTY_LOCAL_TEST_BASE_URL=http://127.0.0.1:8081
SINQ_FACULTY_LOCAL_TEST_PATH=/backend/pulse_api.php?resource=faculty-profiles
SINQ_FACULTY_LOCAL_TEST_TOKEN=replace-with-a-private-random-local-token

# Current-term counts use the prepared loopback Synk API export.
# Reuses SINQ_FACULTY_LOCAL_TEST_TOKEN above in this development environment.
SINQ_ACADEMICS_ENABLED=true
SINQ_ACADEMICS_LOCAL_TEST_ENABLED=true
